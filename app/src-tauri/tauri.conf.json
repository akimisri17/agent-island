{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Island",
  "version": "0.1.0",
  "identifier": "dev.agentisland.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/sync-lib.mjs",
    "beforeBuildCommand": "node scripts/sync-lib.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Agent Island",
        "url": "index.html",
        "width": 340,
        "height": 462,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Watches your coding agents, locally",
    "copyright": "Copyright (c) 2026 Akhil Misri",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
